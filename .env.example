# ───────────────────────── SAUT AI — environment variables ─────────────────────────
# Copy to .env.local for development. In production set these in your host (e.g. Vercel).
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — never put secrets in them.
# If a provider block is left empty, that feature shows "Not configured" in the UI
# and NEVER pretends to succeed.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=KWD
# Show clearly-labelled demo data when Supabase is not configured (true/false)
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (Auth + Postgres + Storage) — Project Settings → API
#   URL + anon key are public by design (RLS protects data).
#   The service_role key bypasses RLS: server only, never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only — used by webhooks & admin actions
SUPABASE_KNOWLEDGE_BUCKET=knowledge   # private storage bucket for knowledge files

# OpenAI (conversation + realtime voice)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=gpt-4o-transcribe

# Twilio (phone numbers, incoming calls, call status)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_HUMAN_FALLBACK_NUMBER=         # where "Transfer to human" calls are routed
VOICE_BRIDGE_WSS_URL=                 # wss:// URL of the realtime media bridge (see docs/DEPLOYMENT.md)

# WhatsApp Business Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=                  # verifies X-Hub-Signature-256 on incoming webhooks
WHATSAPP_BUSINESS_ACCOUNT_ID=         # WABA id: submit/sync message templates

# Stripe (international cards, Apple Pay / Google Pay via Checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# MyFatoorah (KNET, cards, Apple Pay in Kuwait & GCC)
MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com   # https://api.myfatoorah.com in production (KW)
MYFATOORAH_WEBHOOK_SECRET=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="SAUT AI <hello@example.com>"

# Shared secret between the app and the voice bridge — REQUIRED for AI phone calls (generate: openssl rand -hex 32)
# Also signs the 2-minute stream token for each call. Use the same value in services/voice-bridge.
INTERNAL_API_SECRET=

# Error monitoring (optional): a Sentry DSN — errors are sent without any SDK
ERROR_MONITORING_DSN=

# Shared rate limiting across server instances (Upstash Redis REST — recommended on Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# In-app assistant "SO" (dashboard floating button)
# Voice for the assistant's speech (OpenAI TTS voice name). Uses OPENAI_TTS_MODEL / OPENAI_STT_MODEL above.
ASSISTANT_VOICE=coral
# Photoreal talking human face (optional). Without these the built-in SO face is used.
#   Simli: create an API key and pick/create an AI-generated face at https://app.simli.com
SIMLI_API_KEY=
SIMLI_FACE_ID=
