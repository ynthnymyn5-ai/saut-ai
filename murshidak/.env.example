# Murshidak configuration. Every value is optional: with none set, the app runs in demo mode.
PORT=3100
# Postgres connection (Supabase). Use the pooler URL, transaction mode (port 6543).
# When empty, a local SQLite file in DATA_DIR is used instead.
DATABASE_URL=
# Where the local SQLite database lives when DATABASE_URL is empty (default: ./data)
DATA_DIR=
# 32+ random characters used to encrypt uploaded documents and ID numbers at rest.
# Required with DATABASE_URL. Locally, if empty, a key is generated in DATA_DIR/.secret.
# Losing it makes stored documents unreadable: keep a copy somewhere safe.
MURSHIDAK_SECRET=
# LLM for understanding requests. Without a key, a built-in Arabic/English matcher is used.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000
# Phone numbers (8 digits, comma separated) that become admins on sign-in.
ADMIN_PHONES=
# Create the three sample accounts (99999999 family, 98888888 business, 90000000 admin) on first start.
# Default: on for local SQLite, off when DATABASE_URL is set. Never enable on a live database.
SEED_DEMO_ACCOUNTS=
# Set to 1 when served over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=

# ---- Public address of the app (used for payment return links and push). e.g. https://murshidak-khaki.vercel.app
PUBLIC_URL=

# ---- SMS sign-in codes + WhatsApp reminders (Twilio). With SMS set, the on-screen demo code disappears.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                      # an SMS-capable number, or use TWILIO_MESSAGING_SERVICE_SID
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=             # your WhatsApp sender number, e.g. +965XXXXXXXX
TWILIO_WHATSAPP_CONTENT_SID=      # approved template with {{1}} title and {{2}} details (needed to start conversations)

# ---- Phone push notifications (Web Push). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                    # mailto:you@example.com or https://your-site

# ---- Reading document photos (OpenAI vision). Uses OPENAI_API_KEY above.
OPENAI_VISION_MODEL=

# ---- Payments (MyFatoorah: KNET + cards). Test: https://apitest.myfatoorah.com  Kuwait live: https://api.myfatoorah.com
MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=

# ---- Daily reminder job (Vercel Cron sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=
# Commission owed by agents on completed bookings, in percent (admin stats only)
AGENT_COMMISSION_PCT=10
