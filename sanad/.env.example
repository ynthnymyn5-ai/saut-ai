# Copy to .env for local development. On Replit, add these in the Secrets tool instead.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sanad
SESSION_SECRET=change-me-to-a-long-random-string
# AI: Claude is used for reasoning when ANTHROPIC_API_KEY is set.
# OpenAI is still used for embeddings, Whisper, TTS and live voice when OPENAI_API_KEY is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
# Optional
OPENAI_MODEL=gpt-4o
APP_URL=http://localhost:5000
OWNER_EMAIL=
TAVILY_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_OWNER_NUMBER=
NOTION_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
BRIEF_HOUR=7
OWNER_TZ=Asia/Kuwait
BUSINESS_NAME=Noor Studio
BUSINESS_DETAILS=Kuwait City, Kuwait
AUTO_FOLLOWUPS=true
