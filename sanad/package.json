{
  "name": "sanad",
  "version": "1.0.0",
  "private": true,
  "description": "Sanad \u2014 your AI Chief of Staff. Voice + text personal operating system.",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --clear-screen=false server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:push": "drizzle-kit push --force",
    "db:setup": "tsx server/db/setup.ts",
    "db:seed": "tsx server/db/seed.ts",
    "test": "tsx --test server/tests/*.test.ts",
    "build:demo": "node scripts/build-demo.mjs",
    "build:vercel": "node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "clsx": "^2.1.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.74.0",
    "multer": "^2.5.0",
    "openai": "^7.57.0",
    "openid-client": "^6.9.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
