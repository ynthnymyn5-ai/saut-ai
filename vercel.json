{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "git": {
    "deploymentEnabled": {
      "ci-logs": false,
      "android-build": false,
      "e2e-logs": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/maintenance",
      "schedule": "30 0 * * *"
    }
  ],
  "regions": [
    "dub1"
  ]
}
